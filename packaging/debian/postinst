#!/bin/sh
# Reversed by postrm. Anything added here must be removed there.
set -e

case "$1" in
  configure)
    # 'input' normally comes from systemd-udev and 'uinput' from nobody, but
    # neither is guaranteed -- a minimal or containerised system may have
    # neither. Create whichever is missing rather than assuming.
    for grp in input uinput; do
      if ! getent group "$grp" >/dev/null; then
        addgroup --system "$grp"
      fi
    done

    # Load now so the device exists without a reboot.
    modprobe uinput 2>/dev/null || true

    # Re-apply rules to the already-present node. Without this the permissions
    # only take effect at next boot, which is the step every competing project
    # tells the user to perform manually.
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --action=change /sys/devices/virtual/misc/uinput 2>/dev/null || true
    udevadm trigger --subsystem-match=input --action=change 2>/dev/null || true

    # Make the icon and menu entry visible without a re-login.
    if command -v gtk-update-icon-cache >/dev/null; then
      gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
    fi
    if command -v update-desktop-database >/dev/null; then
      update-desktop-database -q /usr/share/applications 2>/dev/null || true
    fi

    # Add the installing user -- SUDO_USER is who ran sudo, not root.
    TARGET_USER="${SUDO_USER:-${PKEXEC_UID:+$(getent passwd "$PKEXEC_UID" | cut -d: -f1)}}"
    if [ -n "$TARGET_USER" ] && [ "$TARGET_USER" != "root" ]; then
      # Record what we changed so postrm only reverses our own additions.
      mkdir -p /var/lib/sensor
      for grp in input uinput; do
        if id -nG "$TARGET_USER" 2>/dev/null | tr ' ' '\n' | grep -qx "$grp"; then
          continue  # already a member; not ours to remove later
        fi
        # Record only what actually succeeded, or postrm would claim to
        # reverse a change that never happened.
        if adduser "$TARGET_USER" "$grp" >/dev/null 2>&1; then
          echo "$TARGET_USER $grp" >> /var/lib/sensor/added-groups
        else
          echo "warning: could not add $TARGET_USER to '$grp'" >&2
        fi
      done

      cat <<MSG

sensor is installed. Two steps remain:
  1. Log out and back in, so your group membership reaches your session.
  2. Run: sensorctl setup

MSG
    fi
    ;;
esac

#DEBHELPER#
exit 0
